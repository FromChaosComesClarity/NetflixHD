{
  "manifest_version": 3,
  "name": "NetflixHD",
  "version": "0.1.0",
  "description": "Home closes NetflixHD and returns to the TV home screen.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
